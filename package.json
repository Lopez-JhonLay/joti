    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "babel-preset-expo": "^58.0.26",
    "convex-test": "^0.0.75",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.15",
    "prettier": "^3.10.1",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "start:dev": "expo start --dev-client",
    "start:go": "expo start --go",
    "android": "expo run:android",
    "test": "jest --runInBand",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc -p convex/tsconfig.json",
    "convex:dev": "convex dev",
    "convex:push": "convex dev --once",
    "convex:codegen": "convex codegen",
    "convex:check": "node scripts/check-convex.mjs",
    "auth:check": "node scripts/check-google-auth.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check",
    "export:android": "expo export --platform android",
    "build:android": "expo run:android"
  }
